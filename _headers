/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://static.cloudflareinsights.com; connect-src https://cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Browsers keep images for 7 days, so art replaced under the same name stays old for them. Not /assets/*: that also matches pages like /assets/memories
/assets-web/*
  Cache-Control: public, max-age=604800
/assets/home/*
  Cache-Control: public, max-age=604800
# Rank badges get redrawn under the same names, so browsers ask first. The ! drops the 7 days set above
/assets-web/rank/*
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate
